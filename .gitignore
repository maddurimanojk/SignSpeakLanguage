data_external/raw/
*.zip
*.tar.gz
*.task

# OS & Editor files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/

# Local env & secret keys
.env
.env.local
*.log
